rules_version = '2';

// =====================================================================
//  REGRAS DE SEGURANÇA DO FIRESTORE — Agendamento SAC / CIN
//
//  Sem servidor próprio, QUEM GARANTE as regras de negócio é este arquivo.
//  Elas são executadas pelo Google, não pelo navegador, e não podem ser
//  burladas por quem abrir o console do navegador.
//
//  Modelo de dados
//   config/geral                 público (leitura)   | admin (escrita)
//   bloqueios/{AAAA-MM-DD}       público (leitura)   | admin (escrita)
//   vagas/{AAAA-MM-DD_HH:MM}     público (leitura)   | cria: cidadão/admin ; apaga: cancelamento/admin
//   agendamentos/{ref}           SOMENTE admin lê    | cidadão só cria e cancela o próprio
//   comprovantes/{chave}         leitura só por "get" (id = chave secreta) | CPF sempre mascarado
//   cpfAtivos/{hash}             ninguém lê          | impede 2 agendamentos ativos do mesmo CPF
//   admins/{uid}                 cada admin lê o próprio | ninguém escreve (criar pelo console)
//   auditoria/*                  admin cria e lê     | ninguém altera/apaga
//
//  Por que "vagas" resolve a duplicidade: o ID do documento é data_hora.
//  Criar um documento que já existe é uma ATUALIZAÇÃO, e atualização de
//  vaga é proibida. Logo, só uma gravação vence, mesmo com acessos simultâneos.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    //  Funções utilitárias
    // ---------------------------------------------------------------
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function pad(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }

    // Horário de Brasília (UTC-3, sem horário de verão desde 2019)
    function hojeBR() {
      let t = request.time - duration.value(3, 'h');
      return string(t.year()) + '-' + pad(t.month()) + '-' + pad(t.day());
    }

    function horaBR() {
      let t = request.time - duration.value(3, 'h');
      return pad(t.hours()) + ':' + pad(t.minutes());
    }

    // Segunda a sexta. 03/01/2000 foi uma segunda-feira: resto da divisão
    // por 7 dias < 5 dias => seg..sex.
    function diaUtil(d) {
      let p = d.split('-');
      let ms = timestamp.date(int(p[0]), int(p[1]), int(p[2])).toMillis()
             - timestamp.date(2000, 1, 3).toMillis();
      return ms % 604800000 < 432000000;
    }

    function horaOk(h) {
      return h in ['08:00', '08:15', '08:30', '08:45',
                   '09:00', '09:15', '09:30', '09:45',
                   '10:00', '10:15', '10:30', '10:45',
                   '11:00', '11:15', '11:30', '11:45',
                   '12:00', '12:15', '12:30', '12:45'];
    }

    function dataFmt(s) {
      return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // ---------------------------------------------------------------
    //  Configuração e datas bloqueadas
    // ---------------------------------------------------------------
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bloqueios/{d} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // ---------------------------------------------------------------
    //  VAGAS  (um documento = um horário ocupado)
    // ---------------------------------------------------------------
    function vagaValida(id, v) {
      return v.keys().hasOnly(['data', 'hora', 'ref'])
        && v.keys().hasAll(['data', 'hora', 'ref'])
        && dataFmt(v.data)
        && diaUtil(v.data)
        && v.hora is string && horaOk(v.hora)
        && id == v.data + '_' + v.hora
        && v.ref is string && v.ref.size() >= 20 && v.ref.size() <= 64
        && !exists(/databases/$(database)/documents/bloqueios/$(v.data));
    }

    // Regras extras que valem só para o cidadão (o admin pode usar
    // datas fora da janela, mas nunca fins de semana, horários inválidos
    // ou datas bloqueadas).
    function reservaPublicaOk(v) {
      let cfg = get(/databases/$(database)/documents/config/geral).data;
      let ag = getAfter(/databases/$(database)/documents/agendamentos/$(v.ref)).data;
      return v.data >= hojeBR()
        && (v.data > hojeBR() || v.hora > horaBR())
        && v.data >= cfg.abertura && v.data <= cfg.fechamento
        && ag.data == v.data && ag.hora == v.hora && ag.status == 'agendado'
        && existsAfter(/databases/$(database)/documents/comprovantes/$(ag.chave))
        && existsAfter(/databases/$(database)/documents/cpfAtivos/$(ag.cpfKey));
    }

    function cancelamentoCidadaoDe(refAg) {
      let p = /databases/$(database)/documents/agendamentos/$(refAg);
      return get(p).data.status == 'agendado'
        && getAfter(p).data.status == 'cancelado'
        && getAfter(p).data.canceladoPor == 'cidadao';
    }

    match /vagas/{id} {
      allow read: if true;
      allow create: if vagaValida(id, request.resource.data)
                    && (isAdmin() || reservaPublicaOk(request.resource.data));
      allow update: if false;
      allow delete: if isAdmin() || cancelamentoCidadaoDe(resource.data.ref);
    }

    // ---------------------------------------------------------------
    //  AGENDAMENTOS  (dados pessoais completos — somente admin lê)
    // ---------------------------------------------------------------
    function agendamentoPublicoOk(refId, v) {
      return v.keys().hasOnly(['ref', 'protocolo', 'nome', 'cpf', 'cpfMasc', 'nascimento',
                               'telefone', 'email', 'certidao', 'data', 'hora', 'status',
                               'origem', 'chave', 'cpfKey', 'criadoEm', 'atualizadoEm'])
        && v.keys().hasAll(['ref', 'protocolo', 'nome', 'cpf', 'cpfMasc', 'nascimento',
                            'telefone', 'email', 'certidao', 'data', 'hora', 'status',
                            'origem', 'chave', 'cpfKey', 'criadoEm', 'atualizadoEm'])
        && v.ref == refId
        && v.status == 'agendado' && v.origem == 'cidadao'
        && v.protocolo is string && v.protocolo.matches('^CIN-[0-9A-Z]{4}-[0-9A-Z]{4}-[0-9A-Z]{4}$')
        && v.nome is string && v.nome.size() >= 5 && v.nome.size() <= 120
        && v.cpf is string && v.cpf.matches('^[0-9]{11}$')
        && v.cpfMasc is string && v.cpfMasc.size() <= 20
        && dataFmt(v.nascimento) && v.nascimento <= hojeBR() && v.nascimento >= '1900-01-01'
        && v.telefone is string && v.telefone.matches('^[0-9]{10,11}$')
        && v.email is string
        && (v.email == '' || (v.email.size() <= 120 && v.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')))
        && v.certidao in ['nascimento', 'casamento']
        && dataFmt(v.data) && horaOk(v.hora)
        && v.chave is string && v.chave.matches('^[0-9a-f]{64}$')
        && v.cpfKey is string && v.cpfKey.matches('^[0-9a-f]{64}$')
        && v.criadoEm == request.time && v.atualizadoEm == request.time
        && existsAfter(/databases/$(database)/documents/vagas/$(v.data + '_' + v.hora))
        && getAfter(/databases/$(database)/documents/vagas/$(v.data + '_' + v.hora)).data.ref == refId;
    }

    // O cidadão só pode mudar o status para "cancelado" (até a véspera),
    // provando que conhece a chave secreta (protocolo + CPF + nascimento):
    // o comprovante dessa chave precisa ser cancelado no mesmo lote.
    function cancelamentoCidadaoOk(a, n) {
      let comp = /databases/$(database)/documents/comprovantes/$(a.chave);
      return a.status == 'agendado' && n.status == 'cancelado'
        && n.diff(a).affectedKeys().hasOnly(['status', 'canceladoEm', 'atualizadoEm', 'canceladoPor'])
        && n.canceladoPor == 'cidadao'
        && n.canceladoEm == request.time && n.atualizadoEm == request.time
        && a.data > hojeBR()
        && get(comp).data.status == 'agendado'
        && get(comp).data.ref == a.ref
        && getAfter(comp).data.status == 'cancelado';
    }

    match /agendamentos/{refId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || agendamentoPublicoOk(refId, request.resource.data);
      allow update: if isAdmin() || cancelamentoCidadaoOk(resource.data, request.resource.data);
      allow delete: if isAdmin();

      match /historico/{h} {
        allow read, create: if isAdmin();
        allow update, delete: if false;
      }
    }

    // ---------------------------------------------------------------
    //  COMPROVANTES  (sem dados completos; o ID é a chave secreta)
    //  Só existe "get": quem não conhece a chave não consegue listar nada.
    // ---------------------------------------------------------------
    function comprovantePublicoOk(k, v) {
      let ag = getAfter(/databases/$(database)/documents/agendamentos/$(v.ref)).data;
      return v.keys().hasOnly(['ref', 'protocolo', 'nome', 'cpfMasc', 'data', 'hora',
                               'certidao', 'status', 'criadoEm'])
        && v.keys().hasAll(['ref', 'protocolo', 'nome', 'cpfMasc', 'data', 'hora',
                            'certidao', 'status', 'criadoEm'])
        && v.status == 'agendado'
        && v.criadoEm == request.time
        && ag.chave == k && ag.protocolo == v.protocolo
        && ag.data == v.data && ag.hora == v.hora && ag.nome == v.nome;
    }

    function comprovanteCancelOk(a, n) {
      let ag = /databases/$(database)/documents/agendamentos/$(a.ref);
      return a.status == 'agendado' && n.status == 'cancelado'
        && n.diff(a).affectedKeys().hasOnly(['status', 'canceladoEm'])
        && a.data > hojeBR()
        && getAfter(ag).data.status == 'cancelado'
        && getAfter(ag).data.canceladoPor == 'cidadao';
    }

    match /comprovantes/{k} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin() || comprovantePublicoOk(k, request.resource.data);
      allow update: if isAdmin() || comprovanteCancelOk(resource.data, request.resource.data);
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    //  CPF ATIVO  (um agendamento ativo por CPF; ninguém lê)
    // ---------------------------------------------------------------
    match /cpfAtivos/{k} {
      allow read: if isAdmin();
      allow create: if k.matches('^[0-9a-f]{64}$')
                    && request.resource.data.keys().hasOnly(['ref'])
                    && (isAdmin()
                        || (existsAfter(/databases/$(database)/documents/agendamentos/$(request.resource.data.ref))
                            && getAfter(/databases/$(database)/documents/agendamentos/$(request.resource.data.ref)).data.cpfKey == k));
      allow update: if false;
      allow delete: if isAdmin() || cancelamentoCidadaoDe(resource.data.ref);
    }

    // ---------------------------------------------------------------
    //  AUDITORIA  (somente inclusão)
    // ---------------------------------------------------------------
    match /auditoria/{a} {
      allow read: if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.em == request.time;
      allow update, delete: if false;
    }

    // Todo o resto é negado por padrão.
  }
}
